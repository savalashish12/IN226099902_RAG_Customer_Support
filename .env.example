# ── API Keys ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Settings ──────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# Set to 1 to enable verbose pipeline logging in the console
RAG_DEBUG=0

# Optional integrations
# Slack incoming webhook for HITL escalation alerts (leave blank to disable)
SLACK_WEBHOOK_URL=

# Optional app password gate (leave blank to disable auth)
APP_PASSWORD=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CHUNKS=60

# ── Retrieval ─────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.65

# ── Confidence Thresholds (L2 Distance) ───────────────────────
# Lower L2 distance = more relevant
HIGH_CONF_THRESHOLD=0.30     # score < 0.30 → HIGH
MEDIUM_CONF_THRESHOLD=0.55   # 0.30 ≤ score < 0.55 → MEDIUM
# score ≥ 0.55 → LOW → always HITL

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DELAY_SECONDS=0.5
